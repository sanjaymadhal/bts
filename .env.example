# Supabase
SUPABASE_URL=https://rzcbmyedznuzwuvybdue.supabase.co
SUPABASE_ANON_KEY=sb_publishable_VRDIo_IbUMyh9_cR1mcKhw_Q4yr42Ew
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
SUPABASE_JWT_SECRET=

# School
SCHOOL_CODE=KSSEM

# Email — Gmail SMTP (no third-party service, no domain to verify)
# Setup: https://myaccount.google.com/apppasswords (requires 2-Step
# Verification enabled first). Use the 16-char app password, NOT
# your real Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Trackr <noreply@trackr.app>

# Driver simulator — runs in-process; produces live bus_positions
# rows so the parent app's map has something to render during demos.
SIMULATE_DRIVERS=true

# Position-ingest shared secret. Distinct from SUPABASE_SERVICE_ROLE_KEY
# so a leaked bearer token can't write arbitrary positions. Generate
# per-environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSITION_SECRET=

# CORS — comma-separated list of allowed origins. Must include the
# EAS bundle origin for the deployed app (e.g.
# https://trackr--staging.expo.app) and the dev-client origin
# (exp://localhost:8081). Local browser testing adds http://localhost:8081.
CORS_ALLOW_ORIGINS=https://trackr.app,https://trackr--staging.expo.app,exp://localhost:8081